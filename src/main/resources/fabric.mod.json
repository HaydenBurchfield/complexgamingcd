{
  "schemaVersion": 1,
  "id": "antigravity",
  "version": "${version}",
  "name": "Antigravity",
  "description": "Antigravity utility mod",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/antigravity/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "org.cheetahv2.antigravity.client.AntigravityDataGenerator"
    ],
    "client": [
      "org.cheetahv2.antigravity.client.AntigravityClient"
    ],
    "main": [
      "org.cheetahv2.antigravity.Antigravity"
    ]
  },
  "mixins": [
